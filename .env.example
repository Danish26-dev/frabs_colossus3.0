# ─────────────────────────────────────────────────────────────────────────────
# FRAB frontend environment
#
# Copy this file to `.env` and fill in the values. All vars are read at build
# time by Vite (they MUST be prefixed with VITE_ to reach the client bundle).
# Restart the dev server after changing any of them.
# ─────────────────────────────────────────────────────────────────────────────

# ── Synthetic Bank API (alert source) ───────────────────────────────────────
# The bank backend: alerts queue, customer/account/KYC context, transaction
# feed, dataset stats. When set, the data layer switches from demo/simulated
# mode to live mode (IS_LIVE_BACKEND = true).
VITE_FRAB_API_URL=https://frab-git-379796489354.asia-south1.run.app

# -- FRAB Investigation Worker (Cloud Run) ------------------------------------
# The worker owns the investigation: risk, evidence, findings, network graph,
# regulatory context, agent reasoning and the recommendation. When set,
# IS_WORKER_LIVE = true and the investigation screens (launch, 3D workspace SSE,
# result console) are driven by the worker instead of the bank bundle.
# Model inference runs on 0G Private Computer; GET /health reports llm_mode
# ("0g" real, "0g-mock" scripted, "offline" none) and the console shows it.
#
# Must be HTTPS when the frontend is served over HTTPS (mixed content is blocked).
# Leave unset to keep the worker path inert (bank/demo behaviour unchanged).
VITE_FRAB_WORKER_URL=https://frab-worker-379796489354.asia-south1.run.app
# Shared token. The worker rejects /investigate* without it (401). Sent as ?token=
# because native EventSource cannot set headers. Get it from the worker owner;
# never commit it. NOTE: VITE_* values are compiled into the browser bundle, so
# this deters casual abuse but is NOT a secret.
VITE_FRAB_WORKER_TOKEN=

# -- FRAB Voice Escalation service (Cloud Run, Vapi adapter) -------------------
# When set, IS_VOICE_LIVE = true and the Case Book "Voice Escalation" drives a
# real call: the analyst escalates, the service calls the customer via Vapi, and
# the structured assessment comes back into the same case. The frontend never
# talks to Vapi directly; all provider secrets stay in the voice service. The
# service resolves each customer's phone number itself, so no phone is set here.
VITE_FRAB_VOICE_URL=https://frab-voice-379796489354.asia-south1.run.app
# Shared token, sent as "Authorization: Bearer". The service rejects voice
# escalation and voice status requests without it (401). Same caveat as above.
VITE_FRAB_VOICE_TOKEN=

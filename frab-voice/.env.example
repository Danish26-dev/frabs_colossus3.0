# FRAB Voice Service — server-side config (NEVER expose to the browser / commit real values)

# Vapi private API key (from the Vapi account owner). On Cloud Run, supply from Secret Manager.
VAPI_API_KEY=

# Existing "FRAB Voice Investigator" assistant id (UUID)
VAPI_ASSISTANT_ID=fad86425-0119-4af0-a8e0-1bb54854d93c

# Outbound phone number. Prefer the Vapi phone-number ID (UUID). A raw +1 number
# is also accepted and auto-resolved to its id at call time.
VAPI_PHONE_NUMBER_ID=2a8e455b-1e1a-4bfa-840b-22e7c409c10c

# Source of authoritative case/customer data (the deployed Synthetic Bank API)
FRAB_BANK_API_URL=https://frab-git-379796489354.asia-south1.run.app

# Where voice-call records persist: firestore (Cloud Run), memory, or a JSON file (local dev)
# VOICE_STORE=firestore
VOICE_STORE_PATH=voice_store.json

# CORS origins for the frontend (comma-separated, or * for demo).
# If unset, defaults to localhost:8080 and the two frab-frontend Cloud Run URLs.
# VOICE_CORS_ORIGINS=

# Shared API token for POST /api/cases/{id}/voice-escalation and GET /api/cases/{id}/voice.
# Sent by the client as "Authorization: Bearer <token>" or "?token=<token>".
# Unset = auth disabled (dev/tests only). Supply from Secret Manager in production.
VOICE_API_TOKEN=

# Optional secret for the Vapi webhook; must match the secret configured in Vapi
# (sent by Vapi in the X-Vapi-Secret header). Unset = webhook check disabled.
VOICE_WEBHOOK_SECRET=

# Phone directory: resolves the customer's number server-side so the frontend need
# not send one. DEMO_CUSTOMER_PHONE maps ALL demo customers to one test number.
# CUSTOMER_PHONE_MAP="C009026167:+91XXXXXXXXXX" maps individual customers.
DEMO_CUSTOMER_PHONE=
CUSTOMER_PHONE_MAP=

# Set to 1 to simulate Vapi without placing real calls (dev/demo/tests)
VAPI_MOCK=1

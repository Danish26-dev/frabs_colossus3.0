# FRAB Worker: server-side config. NEVER commit a real .env, and never expose
# any of these values to the browser. Names only here, no credentials.

# --- Inference provider -----------------------------------------------------
# offline (default, deterministic, no model) | 0g
# FRAB_LLM is accepted as an alias for LLM_PROVIDER.
LLM_PROVIDER=0g

# Mock mode (default true): the 0g provider uses a scripted, network-free mock,
# so nothing is sent to 0G and no credits are spent. Set to false for REAL
# inference (requires ZG_API_KEY and ZG_MODEL below).
LLM_MOCK_MODE=true

# --- 0G Private Computer (used when LLM_PROVIDER=0g and LLM_MOCK_MODE=false) --
# Secret key from pc.0g.ai (starts with "sk-"). On Cloud Run, supply it from
# Secret Manager.
ZG_API_KEY=
# Exact model id available to YOUR account under Private trust mode. Not defaulted.
ZG_MODEL=
ZG_BASE_URL=https://router-api.0g.ai/v1
# Must be "private". Any other value is refused at startup (no downgrade, ever).
ZG_TRUST_MODE=private
ZG_TIMEOUT_SECONDS=60

# Optional spend controls (header values are sent only when set):
# Router-side provider failover between private providers: true | false
# ZG_ALLOW_FALLBACKS=
# Per-request price ceilings, USD per 1M tokens. A request that no private
# provider can serve under the ceiling fails instead of overspending.
# ZG_MAX_PRICE_USD_PROMPT=
# ZG_MAX_PRICE_USD_COMPLETION=

# Model list prices, USD per 1M tokens. Used only to estimate cost in the logs
# and case file (0G reports token counts, not cost).
# ZG_PRICE_USD_PROMPT=
# ZG_PRICE_USD_COMPLETION=
# Model-specific request options as a JSON object. Cannot override the model,
# messages, output cap, temperature or streaming. Example for 0gm-1.0-35b-a3b:
# ZG_EXTRA_BODY={"chat_template_kwargs":{"enable_thinking":false},"response_format":{"type":"json_object"}}

# --- Generation parameters --------------------------------------------------
# Applied to every request. The output cap also bounds the Router's pre-authorised
# balance hold per call, so keep it as low as the agent needs.
LLM_MAX_OUTPUT_TOKENS=1024
LLM_TEMPERATURE=0

# --- Worker -----------------------------------------------------------------
# Shared token for /investigate* (sent as ?token=... or Authorization: Bearer).
# Unset = open (dev/tests only).
FRAB_API_TOKEN=
# Comma-separated CORS origins (defaults include localhost and the frontend).
# FRAB_CORS_ORIGINS=
